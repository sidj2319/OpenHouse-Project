# Copy to .env for local (non-Docker) runs. Never commit the real .env.

PORT=3000

# Product data source (Fake Store API for the PoC)
FAKE_STORE_BASE_URL=https://fakestoreapi.com
PRODUCT_CACHE_TTL_SECONDS=60

# Comma-separated product IDs that are "top rated" on the home page.
# If fewer than 5 are given (or the IDs don't exist), the gap is filled
# with the highest-rated products.
FEATURED_PRODUCT_IDS=1,5,9,13,15

# Enquiry email
SALES_INBOX_EMAIL=sales@example.com
EMAIL_FROM=Catalogue <no-reply@example.com>

# SMTP. Leave SMTP_HOST empty to log emails to the console instead of sending.
# docker compose sets this to the bundled Mailpit container automatically.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
